# Recommended root .gitignore for this multi-part Node/Vite project

# Node modules
node_modules/

# Build outputs
dist/
build/
out/
/.parcel-cache/
/.vite/

# Environment files
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime files
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# System files
.DS_Store
Thumbs.db
desktop.ini

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Uploaded files and user-generated content
uploads/
uploads/**

# Database files
*.sqlite
*.sqlite3
*.db

# Misc
.cache/
.parcel-cache/
.turbo/

# Lock files (optional to ignore - uncomment to ignore)
# package-lock.json
# yarn.lock
